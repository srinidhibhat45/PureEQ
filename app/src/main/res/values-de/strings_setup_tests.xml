<?xml version="1.0" encoding="utf-8"?>
<!-- Making a profile: the setup steps, the listening check and the taste test. -->
<resources>

    <!-- ===== Setup: New profile ===== -->
    <string name="setup_intro_title">Neues Profil</string>
    <string name="setup_intro_start">Starten</string>
    <string name="setup_intro_headline">Finden wir deinen Klang</string>
    <string name="setup_intro_subtitle">Ein Hörcheck für jedes Ohr, dann ein kurzer Geschmackstest.</string>
    <!-- „Ja“ is the listening check's answer button, "A" and "B" the taste test's two options. -->
    <string name="setup_intro_step_check">1 · Hörcheck</string>
    <string name="setup_intro_step_check_text">Tippe auf „Ja“, wenn du einen Ton hörst, auch ganz leise.</string>
    <string name="setup_intro_step_taste">2 · Geschmack</string>
    <string name="setup_intro_step_taste_text">Wähle bei Musik A oder B. Meist 5 bis 7 Runden.</string>
    <string name="setup_intro_step_eq">3 · Dein EQ</string>
    <string name="setup_intro_step_eq_text">Wende ihn auf alle Apps an oder exportiere ihn in deine EQ-App.</string>
    <!-- A heading and its tips; each tip is shown after a bullet. -->
    <string name="setup_intro_tips">Bevor du startest</string>
    <string name="setup_intro_tip_room">Ein ruhiger Raum, Kopfhörer wie gewohnt getragen.</string>
    <string name="setup_intro_tip_effects">Andere Klangeffekte und EQs aus, auch in der App deiner Ohrhörer.</string>
    <string name="setup_intro_tip_noise_cancelling">Geräuschunterdrückung an, Transparenzmodus aus.</string>
    <!-- A switch to include the listening check. Under it, the chosen length, or this text when it is off. -->
    <string name="setup_intro_check">Hörcheck</string>
    <string name="setup_intro_check_skipped">Übersprungen: nur Geschmack</string>

    <!-- ===== Setup: Headphones ===== -->
    <string name="setup_headphones_title">Kopfhörer</string>
    <string name="setup_continue">Weiter</string>
    <string name="setup_headphones_continue_without">Ohne Kopfhörer weiter</string>
    <string name="setup_headphones_headline">Setz deine Kopfhörer auf</string>
    <string name="setup_headphones_subtitle">Nimm die Kopfhörer, mit denen du hören wirst.</string>
    <string name="setup_headphones_none">Keine Kopfhörer erkannt. Der Hörcheck braucht sie.</string>
    <string name="setup_headphones_type">Typ</string>
    <string name="setup_headphones_in_ear">In-Ear / Ohrhörer</string>
    <string name="setup_headphones_over_ear">Over-Ear / On-Ear</string>
    <!-- The headphone model, picked from AutoEq's database. -->
    <string name="setup_model_title">Modell (optional)</string>
    <string name="setup_model_add">Füge die im Labor gemessene Korrektur deines Modells von AutoEq hinzu (über 6.000 Kopfhörer).</string>
    <string name="setup_model_find">Meine Kopfhörer finden</string>
    <string name="setup_model_change">Ändern</string>
    <!-- %1$s: the target curve's name, shown as it is, such as "Harman in-ear 2019". -->
    <string name="setup_model_corrected_to">Korrigiert auf die Zielkurve %1$s.</string>
    <string name="setup_model_corrected_autoeq">Korrigiert auf die Zielkurve, die AutoEq dafür nutzt.</string>
    <string name="setup_model_remembered">Beim letzten Mal für diese Kopfhörer gewählt.</string>
    <!-- %1$s: who measured the headphones, such as "oratory1990". -->
    <string name="setup_model_attribution">Kopfhörerdaten: %1$s über AutoEq (Jaakko Pasanen, MIT)</string>

    <!-- ===== Setup: Room check ===== -->
    <string name="setup_quiet_title">Raumcheck</string>
    <string name="setup_quiet_skip">Überspringen</string>
    <string name="setup_quiet_headline">Ist es leise genug?</string>
    <string name="setup_quiet_subtitle">Geräusche überdecken leise Töne. PureEQ hört 3 Sekunden lang zu und speichert nichts.</string>
    <!-- Under the measured level, such as "38 dB(A)". -->
    <string name="setup_quiet_level">Raumgeräusch</string>
    <string name="setup_quiet_failed">Das Mikrofon konnte nicht verwendet werden. Du kannst das überspringen.</string>
    <string name="setup_quiet_good">Leise genug.</string>
    <string name="setup_quiet_fair">Etwas laut. Geräuschunterdrückung hilft.</string>
    <string name="setup_quiet_noisy">Zu laut. Such dir einen ruhigeren Ort oder schalte die Geräuschunterdrückung ein.</string>
    <string name="setup_quiet_check">Geräusche prüfen</string>
    <string name="setup_quiet_check_again">Erneut prüfen</string>

    <!-- ===== Setup: Volume ===== -->
    <string name="setup_volume_title">Lautstärke</string>
    <string name="setup_volume_confirm">Leise, aber deutlich</string>
    <string name="setup_volume_headline">Lautstärke einstellen</string>
    <string name="setup_volume_subtitle">Stell den Ton leise, aber deutlich ein, wie eine leise tickende Uhr. Behalte diese Lautstärke bis zum Ende bei.</string>
    <!-- Spoken labels of the buttons on either side of the volume slider. -->
    <string name="setup_volume_down">Leiser</string>
    <string name="setup_volume_up">Lauter</string>
    <!-- What TalkBack calls the volume slider. -->
    <string name="setup_volume_name">Medienlautstärke</string>
    <!-- %1$d: the phone's media volume step; %2$d: the highest step. -->
    <string name="setup_volume_level">Lautstärke %1$d von %2$d</string>
    <string name="setup_volume_cant_hear">Selbst bei voller Lautstärke nichts? Prüfe, ob die Kopfhörer verbunden sind.</string>

    <!-- ===== Setup: Left and right (one beep on one side) ===== -->
    <string name="setup_channel_title">Links und rechts</string>
    <string name="setup_channel_volume_again">Lautstärke neu einstellen</string>
    <string name="setup_channel_try_again">Erneut versuchen</string>
    <string name="setup_channel_continue_anyway">Trotzdem weiter</string>
    <string name="setup_channel_headline">Wo war der Ton?</string>
    <string name="setup_channel_subtitle">Auf einer Seite wurde ein Ton gespielt.</string>
    <!-- Answers: where the beep was heard. -->
    <string name="setup_channel_left">Links</string>
    <string name="setup_channel_both">Beide</string>
    <string name="setup_channel_right">Rechts</string>
    <string name="setup_channel_play_again">Noch mal abspielen</string>
    <string name="setup_channel_not_heard">Nichts gehört</string>
    <!-- What the answer showed. -->
    <string name="setup_channel_ok">Richtig. Der Hörcheck startet…</string>
    <string name="setup_channel_swapped">Links und rechts scheinen vertauscht. Prüfe, ob jeder Ohrhörer im richtigen Ohr sitzt, und versuch es dann noch einmal.</string>
    <!-- "Einstellungen › Bedienungshilfen › Audio" is the path to the setting in Android's Settings app. -->
    <string name="setup_channel_mono">Eventuell ist Mono-Audio an. Schalte es aus und stell die Balance unter Einstellungen › Bedienungshilfen › Audio auf die Mitte, dann versuch es noch einmal.</string>
    <string name="setup_channel_missed">Nicht gehört. Prüfe, ob beide Ohrhörer verbunden sind; vielleicht ist die Lautstärke zu niedrig.</string>

    <!-- ===== Listening check ===== -->
    <string name="check_title">Hörcheck</string>
    <!-- Spoken label of the pause button. -->
    <string name="check_pause">Pausieren</string>
    <string name="check_yes">Ja, gehört</string>
    <string name="check_no">Nein</string>
    <string name="check_replay">Ton noch mal abspielen</string>
    <!-- %1$d: percent done, 0 to 100. -->
    <string name="check_progress">%1$d %%</string>
    <!-- Under the animation: while a beep plays, while waiting for the answer, before the next beep. -->
    <string name="check_listen">Hör zu…</string>
    <string name="check_question">Hast du einen Ton gehört?</string>
    <string name="check_get_ready">Mach dich bereit</string>
    <string name="check_instructions">Tippe auf „Ja“, sobald du einen Ton hörst, auch ganz leise. Du kannst jeden Ton einmal erneut abspielen.</string>
    <!-- Shown after „Ja“ answers to silent beeps. -->
    <string name="check_guessing">Manche Töne sind absichtlich stumm. Tippe nur auf „Ja“, wenn du sicher bist.</string>
    <string name="check_got_it">Verstanden</string>
    <!-- The dialog when the check pauses. -->
    <string name="check_paused">Pausiert</string>
    <string name="check_paused_text">Mach weiter, sobald du bereit bist.</string>
    <string name="check_paused_background">Pausiert, während PureEQ im Hintergrund war.</string>
    <!-- The dialog when the volume changed during the check. -->
    <string name="check_volume_changed">Lautstärke geändert</string>
    <string name="check_volume_changed_text">Der Check braucht die Lautstärke, die du am Anfang eingestellt hast.</string>
    <string name="check_restore_volume">Wiederherstellen und weiter</string>
    <!-- The dialog when the headphones disconnected during the check. -->
    <string name="check_headphones_disconnected">Kopfhörer getrennt</string>
    <string name="check_headphones_disconnected_text">Verbinde dieselben Kopfhörer wieder, um weiterzumachen.</string>
    <!-- The pause dialog's buttons. -->
    <string name="check_continue">Weiter</string>
    <string name="check_stop_test">Check beenden</string>
    <!-- Confirms leaving the check with Back. -->
    <string name="check_stop_title">Hörcheck beenden?</string>
    <string name="check_stop_text">Deine bisherigen Antworten werden verworfen.</string>
    <string name="check_stop">Beenden</string>
    <string name="check_keep_going">Weitermachen</string>

    <!-- ===== Listening check: the result ===== -->
    <string name="check_done_continue">Weiter zum Geschmackstest</string>
    <string name="check_done_start_over">Von vorn beginnen</string>
    <string name="check_done_headline">Dein Hörprofil</string>
    <!-- %1$s: check_done_reference_in_ear or check_done_reference_over_ear (dative, after "auf"). -->
    <string name="check_done_explained">Jeder Punkt vergleicht ein Band mit einer Referenzperson auf %1$s. Je tiefer, desto mehr Unterstützung.</string>
    <!-- "…mit einer Referenzperson auf gut abgestimmten In-Ear-Kopfhörern, …" -->
    <string name="check_done_reference_in_ear">gut abgestimmten In-Ear-Kopfhörern</string>
    <string name="check_done_reference_over_ear">gut abgestimmten Over-Ear-Kopfhörern</string>
    <string name="check_done_explained_corrected">Jeder Punkt vergleicht ein Band mit einer Referenzperson, nachdem der gemessene Klang deiner Kopfhörer herausgerechnet wurde. Je tiefer, desto mehr Unterstützung.</string>
    <!-- The chart's legend; ● and ■ are the shapes of each ear's points on the chart. -->
    <string name="check_done_left">● Links</string>
    <string name="check_done_right">■ Rechts</string>
    <!-- A heading and a rating of how consistent the answers were. -->
    <string name="check_done_reliability">Zuverlässigkeit</string>
    <string name="check_done_reference_line">Referenz</string>
    <string name="check_done_good_text">Deine Antworten waren stimmig.</string>
    <string name="check_done_fair_text">Einige Antworten passten nicht zum Rest, das Profil ist aber brauchbar.</string>
    <string name="check_reliability_good">Gut</string>
    <string name="check_reliability_fair">Mittel</string>
    <string name="check_reliability_low">Niedrig</string>
    <!-- The next four sentences make one paragraph, in this order. -->
    <!-- %1$d: silent beeps answered Yes; %2$d: silent beeps played. -->
    <string name="check_done_false_alarms">Stumme Kontrolltöne mit „Ja“ beantwortet: %1$d von %2$d.</string>
    <!-- %1$s: the largest difference, a whole number such as "4". -->
    <string name="check_done_retest">Die Wiederholungsmessung bei 1 kHz wich um bis zu %1$s dB ab.</string>
    <!-- %1$d: answers far off the result; %2$d: all answers to beeps that played. -->
    <string name="check_done_inconsistent">Antworten, die nicht zum Rest passten: %1$d von %2$d.</string>
    <!-- %1$d: all answers; %2$d min %3$d s: how long the check took. -->
    <plurals name="check_done_answers">
        <item quantity="one">%1$d Antwort in %2$d min %3$d s.</item>
        <item quantity="other">%1$d Antworten in %2$d min %3$d s.</item>
    </plurals>
    <!-- %1$d: bands where even the loudest beep was missed, or even the quietest was heard. -->
    <plurals name="check_done_edge">
        <item quantity="one">%1$d Band lag am Rand des Messbereichs; PureEQ korrigiert es weniger.</item>
        <item quantity="other">%1$d Bänder lagen am Rand des Messbereichs; PureEQ korrigiert sie weniger.</item>
    </plurals>
    <string name="check_done_poor">Die Antworten waren nicht sehr stimmig. Ein ruhigerer Raum hilft meist; überleg dir, von vorn zu beginnen.</string>
    <string name="check_done_disclaimer">Ein Hörprofil zur Klangabstimmung, kein Hörtest. PureEQ ist kein Medizinprodukt.</string>

    <!-- ===== Taste test ===== -->
    <string name="taste_title">Geschmack</string>
    <!-- Choosing the music, before and during the taste test. -->
    <string name="taste_music_preparing">Musik wird vorbereitet…</string>
    <string name="taste_music_loading">Wird geladen…</string>
    <string name="taste_music_loops">Läuft in Schleife, während du vergleichst</string>
    <string name="taste_music_mine">Mein Song</string>
    <string name="taste_music_built_in">Integrierter Track</string>
    <!-- Before the taste test. „Gleich“ is the answer button for no preference. -->
    <string name="taste_intro_start">Vergleich starten</string>
    <string name="taste_intro_skip">Überspringen, nur Hörcheck nutzen</string>
    <string name="taste_intro_headline">Und jetzt: Was gefällt dir?</string>
    <string name="taste_intro_subtitle">Wähle bei derselben Musik A oder B. Beide sind gleich laut, also vertrau deinen Ohren. Meist 5 bis 7 Runden.</string>
    <!-- Before redoing the taste test of a saved profile, from Fine-tune. „Zurücksetzen“ is a button there. -->
    <string name="taste_redo_headline">Geschmackstest wiederholen</string>
    <string name="taste_redo_subtitle">Wähle A oder B, meist 5 bis 7 Runden. Das Ergebnis ersetzt deinen Bass und deine Höhen (Wärme und Stimmen gehen auf 0); dein Hörcheck bleibt.</string>
    <string name="taste_music">Musik</string>
    <string name="taste_music_hint">Ein Song, den du gut kennst, funktioniert am besten. Nur Dateien auf deinem Handy.</string>
    <string name="taste_volume">Hörlautstärke</string>
    <string name="taste_volume_text">Spiel mit deiner üblichen Lautstärke: Der Geschmack hängt davon ab.</string>
    <string name="taste_pause">Pausieren</string>
    <string name="taste_play_music">Musik abspielen</string>
    <!-- The comparison. Above the answer buttons: while a new pair starts, until B was heard, then. -->
    <string name="taste_wait">Neues Paar…</string>
    <string name="taste_hear_b">Hör dir auch B an, dann wähle.</string>
    <string name="taste_question">Was gefällt dir besser?</string>
    <string name="taste_a_better">A ist besser</string>
    <string name="taste_same">Gleich</string>
    <string name="taste_b_better">B ist besser</string>
    <string name="taste_finish">Jetzt beenden</string>
    <!-- %1$d: the number of the round being played. -->
    <string name="taste_round">Runde %1$d</string>
    <!-- Next to the round: how many rounds it usually takes. -->
    <string name="taste_rounds_usual">meist 5 bis 7</string>
    <string name="taste_new_pair">Neues Paar. Hör dir beide noch einmal an.</string>
    <string name="taste_how">Tippe auf A und B, um so oft du willst zu wechseln.</string>
    <string name="taste_pause_music">Musik pausieren</string>
    <!-- The letters on the two big tiles; the same letters as in the texts about A and B. -->
    <string name="taste_a">A</string>
    <string name="taste_b">B</string>
    <!-- Under a tile's letter: playing now, heard already, not heard yet. -->
    <string name="taste_tile_playing">Läuft</string>
    <string name="taste_tile_heard">Gehört · zum Wechseln tippen</string>
    <string name="taste_tile_new">Zum Anhören tippen</string>

    <!-- Listening modes (1.7). -->
    <string name="setup_use_title">Deine Nutzung</string>
    <string name="setup_use_headline">Wofür nutzt du sie meistens?</string>
    <string name="setup_use_headline_named">Wofür nutzt du %1$s meistens?</string>
    <string name="setup_use_subtitle">PureEQ stimmt deinen Sound darauf ab.</string>
    <string name="setup_use_switch_later">Nicht sicher? Wähle Auto. Du kannst jederzeit wechseln.</string>
</resources>
