<?xml version="1.0" encoding="utf-8"?>
<!-- Making a profile: the setup steps, the listening check and the taste test. -->
<resources>

    <!-- ===== Setup: New profile ===== -->
    <string name="setup_intro_title">Nuevo perfil</string>
    <string name="setup_intro_start">Empezar</string>
    <string name="setup_intro_headline">Vamos a encontrar tu sonido</string>
    <string name="setup_intro_subtitle">Una prueba de escucha para cada oído y luego una breve prueba de gustos.</string>
    <!-- "Sí" is the listening check's answer button, "A" and "B" the taste test's two options. -->
    <string name="setup_intro_step_check">1 · Prueba de escucha</string>
    <string name="setup_intro_step_check_text">Toca Sí cada vez que oigas un pitido, aunque sea débil.</string>
    <string name="setup_intro_step_taste">2 · Gustos</string>
    <string name="setup_intro_step_taste_text">Elige A o B con música. Normalmente de 5 a 7 rondas.</string>
    <string name="setup_intro_step_eq">3 · Tu EQ</string>
    <string name="setup_intro_step_eq_text">Aplícalo a todo el audio o expórtalo a tu app de EQ.</string>
    <string name="setup_intro_tips">Antes de empezar</string>
    <string name="setup_intro_tip_room">Una habitación tranquila y los auriculares puestos como siempre.</string>
    <string name="setup_intro_tip_effects">Otros efectos de sonido y EQ desactivados, también en la app de tus auriculares.</string>
    <string name="setup_intro_tip_noise_cancelling">Cancelación de ruido activada, modo de transparencia desactivado.</string>
    <string name="setup_intro_check">Prueba de escucha</string>
    <string name="setup_intro_check_skipped">Omitida: solo gustos</string>

    <!-- ===== Setup: Headphones ===== -->
    <string name="setup_headphones_title">Auriculares</string>
    <string name="setup_continue">Continuar</string>
    <string name="setup_headphones_continue_without">Continuar sin auriculares</string>
    <string name="setup_headphones_headline">Ponte los auriculares</string>
    <string name="setup_headphones_subtitle">Usa los auriculares con los que vas a escuchar.</string>
    <string name="setup_headphones_none">No se detectaron auriculares. La prueba de escucha los necesita.</string>
    <string name="setup_headphones_type">Tipo</string>
    <string name="setup_headphones_in_ear">Intraurales / de botón</string>
    <string name="setup_headphones_over_ear">Circumaurales / supraaurales</string>
    <!-- The headphone model, picked from AutoEq's database. -->
    <string name="setup_model_title">Modelo (opcional)</string>
    <string name="setup_model_add">Añade la corrección medida en laboratorio de tu modelo desde AutoEq (más de 6000 auriculares).</string>
    <string name="setup_model_find">Buscar mis auriculares</string>
    <string name="setup_model_change">Cambiar</string>
    <!-- %1$s: the target curve's name, shown as it is, such as "Harman in-ear 2019". -->
    <string name="setup_model_corrected_to">Corregido a la curva objetivo %1$s.</string>
    <string name="setup_model_corrected_autoeq">Corregido a la curva objetivo de AutoEq para este modelo.</string>
    <string name="setup_model_remembered">Elegido para estos auriculares la última vez.</string>
    <string name="setup_model_attribution">Datos de auriculares: %1$s a través de AutoEq (Jaakko Pasanen, MIT)</string>

    <!-- ===== Setup: Room check ===== -->
    <string name="setup_quiet_title">Ruido ambiente</string>
    <string name="setup_quiet_skip">Omitir</string>
    <string name="setup_quiet_headline">¿Hay suficiente silencio?</string>
    <string name="setup_quiet_subtitle">El ruido tapa los pitidos suaves. PureEQ escucha durante 3 segundos y no guarda nada.</string>
    <!-- Under the measured level, such as "38 dB(A)". -->
    <string name="setup_quiet_level">ruido ambiente</string>
    <string name="setup_quiet_failed">No se pudo usar el micrófono. Puedes omitir este paso.</string>
    <string name="setup_quiet_good">Hay suficiente silencio.</string>
    <string name="setup_quiet_fair">Algo de ruido. La cancelación de ruido ayuda.</string>
    <string name="setup_quiet_noisy">Demasiado ruido. Busca un lugar más tranquilo o activa la cancelación de ruido.</string>
    <string name="setup_quiet_check">Medir ruido</string>
    <string name="setup_quiet_check_again">Volver a medir</string>

    <!-- ===== Setup: Volume ===== -->
    <string name="setup_volume_title">Volumen</string>
    <string name="setup_volume_confirm">Suave pero claro</string>
    <string name="setup_volume_headline">Ajusta el volumen</string>
    <string name="setup_volume_subtitle">Deja el pitido suave pero claro, como el tictac de un reloj. Mantén este volumen hasta el final.</string>
    <string name="setup_volume_down">Más bajo</string>
    <string name="setup_volume_up">Más alto</string>
    <string name="setup_volume_name">Volumen multimedia</string>
    <!-- %1$d: the phone's media volume step; %2$d: the highest step. -->
    <string name="setup_volume_level">Volumen %1$d de %2$d</string>
    <string name="setup_volume_cant_hear">¿No oyes nada ni al máximo? Comprueba que los auriculares estén conectados.</string>

    <!-- ===== Setup: Left and right (one beep on one side) ===== -->
    <string name="setup_channel_title">Izquierda y derecha</string>
    <string name="setup_channel_volume_again">Ajustar el volumen de nuevo</string>
    <string name="setup_channel_try_again">Reintentar</string>
    <string name="setup_channel_continue_anyway">Continuar de todos modos</string>
    <string name="setup_channel_headline">¿Dónde sonó el pitido?</string>
    <string name="setup_channel_subtitle">Sonó un pitido en un lado.</string>
    <string name="setup_channel_left">Izquierda</string>
    <string name="setup_channel_both">Ambos</string>
    <string name="setup_channel_right">Derecha</string>
    <string name="setup_channel_play_again">Repetir</string>
    <string name="setup_channel_not_heard">No lo oí</string>
    <string name="setup_channel_ok">Correcto. Iniciando la prueba de escucha…</string>
    <string name="setup_channel_swapped">Parece que izquierda y derecha están invertidas. Comprueba que cada auricular esté en el oído correcto y vuelve a intentarlo.</string>
    <!-- "Ajustes > Accesibilidad > Audio" is the path to the setting in Android's Settings app. -->
    <string name="setup_channel_mono">Puede que el audio mono esté activado. Desactívalo y centra el balance en Ajustes > Accesibilidad > Audio; luego, vuelve a intentarlo.</string>
    <string name="setup_channel_missed">No se oyó. Comprueba que ambos auriculares estén conectados; puede que el volumen esté demasiado bajo.</string>

    <!-- ===== Listening check ===== -->
    <string name="check_title">Prueba de escucha</string>
    <string name="check_pause">Pausar</string>
    <string name="check_yes">Sí, lo oí</string>
    <string name="check_no">No</string>
    <string name="check_replay">Repetir ese pitido</string>
    <!-- How far the check is. %1$d: percent done, 0 to 100. -->
    <string name="check_progress">%1$d %%</string>
    <string name="check_listen">Escucha…</string>
    <string name="check_question">¿Oíste un pitido?</string>
    <string name="check_get_ready">Prepárate</string>
    <!-- "Sí" is the answer button. -->
    <string name="check_instructions">Toca Sí en cuanto oigas un pitido, aunque sea débil. Puedes repetir cada pitido una vez.</string>
    <string name="check_guessing">Algunos pitidos son silenciosos a propósito. Toca Sí solo cuando no tengas dudas.</string>
    <string name="check_got_it">Entendido</string>
    <string name="check_paused">En pausa</string>
    <string name="check_paused_text">Continúa cuando quieras.</string>
    <string name="check_paused_background">En pausa mientras PureEQ estaba en segundo plano.</string>
    <string name="check_volume_changed">El volumen cambió</string>
    <string name="check_volume_changed_text">La prueba necesita el volumen que ajustaste al principio.</string>
    <string name="check_restore_volume">Restaurar volumen y continuar</string>
    <string name="check_headphones_disconnected">Auriculares desconectados</string>
    <string name="check_headphones_disconnected_text">Vuelve a conectar los mismos auriculares para continuar.</string>
    <string name="check_continue">Continuar</string>
    <string name="check_stop_test">Detener prueba</string>
    <string name="check_stop_title">¿Detener la prueba de escucha?</string>
    <string name="check_stop_text">Se descartarán las respuestas dadas hasta ahora.</string>
    <string name="check_stop">Detener</string>
    <string name="check_keep_going">Seguir</string>

    <!-- ===== Listening check: the result ===== -->
    <string name="check_done_continue">Seguir con tus gustos</string>
    <string name="check_done_start_over">Empezar de nuevo</string>
    <string name="check_done_headline">Tu perfil de escucha</string>
    <!-- %1$s: the reference headphones, check_done_reference_in_ear or check_done_reference_over_ear. -->
    <string name="check_done_explained">Cada punto compara una banda con un oyente de referencia que usa %1$s. Cuanto más abajo, más ayuda.</string>
    <!-- The reference headphones in the sentence above: "…un oyente de referencia con unos auriculares intraurales bien afinados, …" -->
    <string name="check_done_reference_in_ear">unos auriculares intraurales bien afinados</string>
    <string name="check_done_reference_over_ear">unos auriculares circumaurales bien afinados</string>
    <string name="check_done_explained_corrected">Cada punto compara una banda con un oyente de referencia, descontando el sonido medido de tus auriculares. Cuanto más abajo, más ayuda.</string>
    <!-- The chart's legend; ● and ■ are the shapes of each ear's points on the chart. -->
    <string name="check_done_left">● Izquierdo</string>
    <string name="check_done_right">■ Derecho</string>
    <string name="check_done_reliability">Fiabilidad</string>
    <string name="check_done_reference_line">Referencia</string>
    <string name="check_done_good_text">Tus respuestas fueron coherentes.</string>
    <string name="check_done_fair_text">Algunas respuestas no encajaron con el resto, pero el perfil sirve.</string>
    <string name="check_reliability_good">Buena</string>
    <string name="check_reliability_fair">Aceptable</string>
    <string name="check_reliability_low">Baja</string>
    <!-- %1$d: silent beeps answered Yes; %2$d: silent beeps played. -->
    <string name="check_done_false_alarms">Pitidos de control silenciosos respondidos con Sí: %1$d de %2$d.</string>
    <!-- %1$s: the largest difference, a whole number such as "4". -->
    <string name="check_done_retest">La repetición a 1 kHz difirió hasta en %1$s dB.</string>
    <string name="check_done_inconsistent">Respuestas que no encajaban con el resto: %1$d de %2$d.</string>
    <!-- %1$d: all answers; %2$d min %3$d s: how long the check took. -->
    <plurals name="check_done_answers">
        <item quantity="one">%1$d respuesta en %2$d min %3$d s.</item>
        <item quantity="many">%1$d respuestas en %2$d min %3$d s.</item>
        <item quantity="other">%1$d respuestas en %2$d min %3$d s.</item>
    </plurals>
    <!-- %1$d: bands where even the loudest beep was missed, or even the quietest was heard. -->
    <plurals name="check_done_edge">
        <item quantity="one">%1$d banda estaba en el extremo del rango de la prueba; PureEQ la corrige menos.</item>
        <item quantity="many">%1$d bandas estaban en el extremo del rango de la prueba; PureEQ las corrige menos.</item>
        <item quantity="other">%1$d bandas estaban en el extremo del rango de la prueba; PureEQ las corrige menos.</item>
    </plurals>
    <string name="check_done_poor">Las respuestas no fueron muy coherentes. Una habitación más tranquila suele ayudar; plantéate empezar de nuevo.</string>
    <string name="check_done_disclaimer">Un perfil de escucha para ajustar el sonido, no un examen auditivo. PureEQ no es un dispositivo médico.</string>

