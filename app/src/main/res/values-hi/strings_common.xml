    <!-- Listening modes (1.7). -->
    <string name="use_gaming">गेमिंग</string>
    <string name="use_gaming_detail">कदमों की आहट और संकेत उभरकर आएं, धमाके उन्हें न दबाएं।</string>
    <string name="use_gaming_does">बेस −3 dB या उससे कम, ताकि धमाके कदमों की आहट न दबाएं; जहां कदम और रीलोड सुनाई देते हैं वहां +2 dB; ट्रेबल कभी कम नहीं, ताकि पता चले कि आवाज़ किस तरफ़ से आ रही है; और लगभग 20 ms कम देरी। Android के लो-लेटेंसी रास्ते वाले गेम तक कोई भी EQ नहीं पहुंचता।</string>
    <string name="use_music">संगीत</string>
    <string name="use_music_detail">आपका साउंड ठीक वैसा जैसा ट्यून किया: पूरा बेस, पूरी डायनैमिक्स।</string>
    <string name="use_music_does">आपका साउंड ठीक वैसा, जैसा आपने ट्यून किया: हेडफ़ोन करेक्शन, आपके कान और आपकी पसंद, पूरे बेस के साथ, और हर तेज़ और धीमा पल वैसा ही जैसा कलाकार ने बनाया। बेस अब भी वॉल्यूम के हिसाब से बदलता है।</string>
    <string name="use_voice">वॉइस</string>
    <string name="use_voice_detail">पॉडकास्ट, ऑडियोबुक, वॉइस नोट और बातचीत वाले वीडियो।</string>
    <string name="use_voice_does">साफ़, पास लगती आवाज़ें: बेस में कम गूंज, 2 kHz पर +2.5 dB स्पष्टता, बेस या ट्रेबल में कोई बढ़ोतरी नहीं, पूरी ताकत पर आपकी कान की ट्यूनिंग, और ज़्यादा तेज़ या धीमे बोलने वालों के लिए लेवलर। Android पर फ़ोन कॉल और ऐप कॉल किसी भी EQ ऐप से होकर नहीं गुज़रतीं, इसलिए वे वैसी ही बजती हैं जैसी फ़ोन उन्हें बनाता है।</string>
    <string name="use_general">सामान्य</string>
    <string name="use_general_detail">थोड़ा-थोड़ा सब कुछ: वीडियो, सोशल ऐप, पॉडकास्ट, संगीत।</string>
    <string name="use_general_does">आपका साउंड, आवाज़ों के लिए थोड़ी ज़्यादा स्पष्टता के साथ (2.5 kHz के आसपास +1.5 dB), और एक धीमा लेवलर जो तेज़ पलों को कम करता है, ताकि ऐप और वीडियो बदलते समय वॉल्यूम कम बार बदलना पड़े। आपकी पसंद वैसी ही रहती है जैसी ट्यून की थी।</string>
</resources>
