<?xml version="1.0" encoding="utf-8"?>
<!-- Making a profile: the setup steps, the listening check and the taste test. -->
<resources>

    <!-- ===== Setup: New profile ===== -->
    <string name="setup_intro_title">New profile</string>
    <string name="setup_intro_start">Start</string>
    <string name="setup_intro_headline">Let\'s find your sound</string>
    <string name="setup_intro_subtitle">A listening check for each ear, then a short taste test.</string>
    <!-- The three steps of making a profile, each a title and a text. "Yes" is the listening
         check's answer button, "A" and "B" the taste test's two options. -->
    <string name="setup_intro_step_check">1 · Listening check</string>
    <string name="setup_intro_step_check_text">Tap Yes whenever you hear a beep, even faintly.</string>
    <string name="setup_intro_step_taste">2 · Taste</string>
    <string name="setup_intro_step_taste_text">Pick A or B on music. Usually 5 to 7 rounds.</string>
    <string name="setup_intro_step_eq">3 · Your EQ</string>
    <string name="setup_intro_step_eq_text">Apply it to all audio, or export it to your EQ app.</string>
    <!-- A heading and its tips; each tip is shown after a bullet. -->
    <string name="setup_intro_tips">Before you start</string>
    <string name="setup_intro_tip_room">A quiet room, headphones worn as usual.</string>
    <string name="setup_intro_tip_effects">Other sound effects and EQs off, including in your earbuds\' app.</string>
    <string name="setup_intro_tip_noise_cancelling">Noise cancelling on, transparency off.</string>
    <!-- A switch to include the listening check. Under it, the chosen length, or this text when it is off. -->
    <string name="setup_intro_check">Listening check</string>
    <string name="setup_intro_check_skipped">Skipped: taste only</string>

    <!-- ===== Setup: Headphones ===== -->
    <string name="setup_headphones_title">Headphones</string>
    <!-- Button on the Headphones and Room check steps. -->
    <string name="setup_continue">Continue</string>
    <string name="setup_headphones_continue_without">Continue without headphones</string>
    <string name="setup_headphones_headline">Put on your headphones</string>
    <string name="setup_headphones_subtitle">Use the pair you\'ll listen with.</string>
    <string name="setup_headphones_none">No headphones detected. The listening check needs them.</string>
    <!-- The kind of headphones: a heading and two choices. -->
    <string name="setup_headphones_type">Type</string>
    <string name="setup_headphones_in_ear">In-ear / earbuds</string>
    <string name="setup_headphones_over_ear">Over-ear / on-ear</string>

    <!-- ===== Setup: what the headphones are for (the profile's listening mode) ===== -->
    <string name="setup_use_title">Your use</string>
    <string name="setup_use_headline">What will you mostly use them for?</string>
    <!-- %1$s: the headphones, such as "Galaxy Buds2 Pro". -->
    <string name="setup_use_headline_named">What will you mostly use %1$s for?</string>
    <string name="setup_use_subtitle">PureEQ tunes your sound for it.</string>
    <string name="setup_use_switch_later">Not sure? Pick Auto. You can switch any time.</string>
    <!-- The headphone model, picked from AutoEq's database. -->
    <string name="setup_model_title">Model (optional)</string>
    <string name="setup_model_add">Add your model\'s lab-measured correction from AutoEq (over 6,000 headphones).</string>
    <string name="setup_model_find">Find my headphones</string>
    <string name="setup_model_change">Change</string>
    <!-- Under the picked model's name. %1$s: the target curve's name, shown as it is, such as "Harman in-ear 2019". -->
    <string name="setup_model_corrected_to">Corrected to the %1$s target.</string>
    <!-- Instead of the sentence above, for a model whose correction comes ready-made from AutoEq. -->
    <string name="setup_model_corrected_autoeq">Corrected to AutoEq\'s target for it.</string>
    <!-- Follows one of the two sentences above when the model was remembered from last time. -->
    <string name="setup_model_remembered">Picked for these headphones last time.</string>
    <!-- Credit under the model. %1$s: who measured the headphones, such as "oratory1990". -->
    <string name="setup_model_attribution">Headphone data: %1$s via AutoEq (Jaakko Pasanen, MIT)</string>

    <!-- ===== Setup: Room check ===== -->
    <string name="setup_quiet_title">Room check</string>
    <string name="setup_quiet_skip">Skip check</string>
    <string name="setup_quiet_headline">Is it quiet enough?</string>
    <string name="setup_quiet_subtitle">Noise hides quiet beeps. PureEQ listens for 3 seconds and saves nothing.</string>
    <!-- Under the measured level, such as "38 dB(A)". -->
    <string name="setup_quiet_level">room noise</string>
    <string name="setup_quiet_failed">Couldn\'t use the microphone. You can skip this.</string>
    <string name="setup_quiet_good">Quiet enough.</string>
    <string name="setup_quiet_fair">A little noisy. Noise cancelling helps.</string>
    <string name="setup_quiet_noisy">Too noisy. Find a quieter spot or turn on noise cancelling.</string>
    <string name="setup_quiet_check">Check noise</string>
    <string name="setup_quiet_check_again">Check again</string>

    <!-- ===== Setup: Volume ===== -->
    <string name="setup_volume_title">Volume</string>
    <string name="setup_volume_confirm">It\'s soft but clear</string>
    <string name="setup_volume_headline">Set the volume</string>
    <string name="setup_volume_subtitle">Make the beep soft but clear, like a quiet clock. Keep this volume until the end.</string>
    <!-- Spoken labels of the buttons on either side of the volume slider. -->
    <string name="setup_volume_down">Quieter</string>
    <string name="setup_volume_up">Louder</string>
    <!-- Under the volume slider. %1$d: the phone's media volume step; %2$d: the highest step. -->
    <!-- What TalkBack calls the volume slider. -->
    <string name="setup_volume_name">Media volume</string>
    <string name="setup_volume_level">Volume %1$d of %2$d</string>
    <string name="setup_volume_cant_hear">Nothing even at full volume? Check the headphones are connected.</string>

    <!-- ===== Setup: Left and right (one beep on one side) ===== -->
    <string name="setup_channel_title">Left and right</string>
    <string name="setup_channel_volume_again">Set the volume again</string>
    <string name="setup_channel_try_again">Try again</string>
    <string name="setup_channel_continue_anyway">Continue anyway</string>
    <string name="setup_channel_headline">Where was the beep?</string>
    <string name="setup_channel_subtitle">One beep played on one side.</string>
    <!-- Answers: where the beep was heard. -->
    <string name="setup_channel_left">Left</string>
    <string name="setup_channel_both">Both</string>
    <string name="setup_channel_right">Right</string>
    <string name="setup_channel_play_again">Play again</string>
    <string name="setup_channel_not_heard">I didn\'t hear it</string>
    <!-- What the answer showed. -->
    <string name="setup_channel_ok">Correct. Starting the listening check…</string>
    <string name="setup_channel_swapped">Left and right look swapped. Check each earbud is in the right ear, then try again.</string>
    <!-- "Settings > Accessibility > Audio" is the path to the setting in Android's Settings app. -->
    <string name="setup_channel_mono">Mono audio may be on. Turn it off and centre the balance in Settings > Accessibility > Audio, then try again.</string>
    <string name="setup_channel_missed">Missed. Check both earbuds are connected; the volume may be too low.</string>

    <!-- ===== Listening check ===== -->
    <string name="check_title">Listening check</string>
    <!-- Spoken label of the pause button. -->
    <string name="check_pause">Pause</string>
    <string name="check_yes">Yes, I heard it</string>
    <string name="check_no">No</string>
    <string name="check_replay">Play that beep again</string>
    <!-- How far the check is. %1$d: percent done, 0 to 100. -->
    <string name="check_progress">%1$d%%</string>
    <!-- Under the animation: while a beep plays, while waiting for the answer, before the next beep. -->
    <string name="check_listen">Listen…</string>
    <string name="check_question">Did you hear a beep?</string>
    <string name="check_get_ready">Get ready</string>
    <!-- "Yes" is the answer button. -->
    <string name="check_instructions">Tap Yes as soon as you hear a beep, even faintly. You can replay each beep once.</string>
    <!-- Shown after Yes answers to silent beeps. -->
    <string name="check_guessing">Some beeps are silent on purpose. Only tap Yes when you\'re sure.</string>
    <string name="check_got_it">Got it</string>
    <!-- The dialog when the check pauses: the listener paused it, or PureEQ went to the background. -->
    <string name="check_paused">Paused</string>
    <string name="check_paused_text">Continue whenever you\'re ready.</string>
    <string name="check_paused_background">Paused while PureEQ was in the background.</string>
    <!-- The dialog when the volume changed during the check. -->
    <string name="check_volume_changed">Volume changed</string>
    <string name="check_volume_changed_text">The test needs the volume you set at the start.</string>
    <string name="check_restore_volume">Restore volume and continue</string>
    <!-- The dialog when the headphones disconnected during the check. -->
    <string name="check_headphones_disconnected">Headphones disconnected</string>
    <string name="check_headphones_disconnected_text">Reconnect the same headphones to continue.</string>
    <!-- The pause dialog's buttons. -->
    <string name="check_continue">Continue</string>
    <string name="check_stop_test">Stop test</string>
    <!-- Confirms leaving the check with Back. -->
    <string name="check_stop_title">Stop the listening check?</string>
    <string name="check_stop_text">Your answers so far will be discarded.</string>
    <string name="check_stop">Stop</string>
    <string name="check_keep_going">Keep going</string>

    <!-- ===== Listening check: the result ===== -->
    <string name="check_done_continue">Continue to taste</string>
    <string name="check_done_start_over">Start over</string>
    <string name="check_done_headline">Your listening profile</string>
    <!-- How to read the chart, when no headphone model was picked. %1$s: the reference headphones,
         check_done_reference_in_ear or check_done_reference_over_ear. -->
    <string name="check_done_explained">Each point compares a band with a reference listener on %1$s. Lower gets more help.</string>
    <!-- The reference headphones in the sentence above: "…with a reference listener on well-tuned in-ear headphones, …" -->
    <string name="check_done_reference_in_ear">well-tuned in-ear headphones</string>
    <string name="check_done_reference_over_ear">well-tuned over-ear headphones</string>
    <!-- How to read the chart, when the picked headphone model's measured response is taken out. -->
    <string name="check_done_explained_corrected">Each point compares a band with a reference listener, with your headphones\' measured sound taken out. Lower gets more help.</string>
    <!-- The chart's legend; ● and ■ are the shapes of each ear's points on the chart. -->
    <string name="check_done_left">● Left</string>
    <string name="check_done_right">■ Right</string>
    <!-- What the chart's values mean. -->
    <string name="check_done_axis">dB, relative to the reference</string>
    <!-- A heading and a rating of how consistent the answers were. -->
    <string name="check_done_reliability">Reliability</string>
    <string name="check_reliability_good">Good</string>
    <string name="check_reliability_fair">Fair</string>
    <string name="check_reliability_low">Low</string>
    <!-- The next four sentences make one paragraph, in this order. The second appears only for a
         check made with PureEQ 1.0 or 1.1, the third only for one made with 1.2 or later. -->
    <!-- %1$d: silent beeps answered Yes; %2$d: silent beeps played. -->
    <string name="check_done_false_alarms">Silent check beeps answered Yes: %1$d of %2$d.</string>
    <!-- %1$s: the largest difference, a whole number such as "4". -->
    <string name="check_done_retest">1 kHz re-check differed by up to %1$s dB.</string>
    <!-- %1$d: answers far off the result; %2$d: all answers to beeps that played. -->
    <string name="check_done_inconsistent">Answers that didn\'t fit the rest: %1$d of %2$d.</string>
    <!-- %1$d: all answers; %2$d min %3$d s: how long the check took. The English "one" form keeps
         "answers", as the app has always shown it. -->
    <plurals name="check_done_answers">
        <item quantity="one">%1$d answers in %2$d min %3$d s.</item>
        <item quantity="other">%1$d answers in %2$d min %3$d s.</item>
    </plurals>
    <!-- %1$d: bands where even the loudest beep was missed, or even the quietest was heard. -->
    <plurals name="check_done_edge">
        <item quantity="one">%1$d band was at the edge of the test range; PureEQ corrects it less.</item>
        <item quantity="other">%1$d bands were at the edge of the test range; PureEQ corrects them less.</item>
    </plurals>
    <string name="check_done_poor">The answers weren\'t very consistent. A quieter room usually helps; consider starting over.</string>
    <string name="check_done_disclaimer">A listening profile for tuning sound, not a hearing test. PureEQ is not a medical device.</string>

    <!-- ===== Taste test ===== -->
    <string name="taste_title">Taste</string>
    <!-- Choosing the music, before and during the taste test. -->
    <string name="taste_music_preparing">Preparing music…</string>
    <string name="taste_music_loading">Loading…</string>
    <string name="taste_music_loops">Loops while you compare</string>
    <string name="taste_music_mine">My song</string>
    <string name="taste_music_built_in">Built-in track</string>
    <!-- Before the taste test. "Same" is the answer button for no preference. -->
    <string name="taste_intro_start">Start comparing</string>
    <string name="taste_intro_skip">Skip, use the listening check only</string>
    <string name="taste_intro_headline">Now, what do you like?</string>
    <string name="taste_intro_subtitle">Pick A or B on the same music. Both are equally loud, so trust your ears. Usually 5 to 7 rounds.</string>
    <!-- Before redoing the taste test of a saved profile, from Fine-tune. -->
    <string name="taste_redo_headline">Redo the taste test</string>
    <string name="taste_redo_subtitle">Pick A or B, usually 5 to 7 rounds. The result replaces your bass and treble (warmth and vocals go to 0); your listening check stays.</string>
    <string name="taste_music">Music</string>
    <string name="taste_music_hint">A song you know well works best. Files on your phone only.</string>
    <string name="taste_volume">Listening volume</string>
    <string name="taste_volume_text">Play at your usual volume: taste depends on it.</string>
    <string name="taste_pause">Pause</string>
    <string name="taste_play_music">Play music</string>
    <!-- The comparison. Above the answer buttons: while a new pair starts, until B was heard, then. -->
    <string name="taste_wait">New pair…</string>
    <string name="taste_hear_b">Listen to B as well, then choose.</string>
    <string name="taste_question">Which do you enjoy more?</string>
    <string name="taste_a_better">A is better</string>
    <string name="taste_same">Same</string>
    <string name="taste_b_better">B is better</string>
    <string name="taste_finish">Finish now</string>
    <!-- %1$d: the number of the round being played. -->
    <string name="taste_round">Round %1$d</string>
    <!-- Next to the round: how many rounds it usually takes. -->
    <string name="taste_rounds_usual">usually 5 to 7</string>
    <string name="taste_new_pair">New pair. Listen to both again.</string>
    <string name="taste_how">Tap A and B to switch as often as you like.</string>
    <string name="taste_pause_music">Pause music</string>
    <!-- The letters on the two big tiles; the same letters as in the texts about A and B. -->
    <string name="taste_a">A</string>
    <string name="taste_b">B</string>
    <!-- Under a tile's letter: playing now, heard already, not heard yet. -->
    <string name="taste_tile_playing">Playing</string>
    <string name="taste_tile_heard">Heard · tap to switch</string>
    <string name="taste_tile_new">Tap to hear</string>
</resources>
