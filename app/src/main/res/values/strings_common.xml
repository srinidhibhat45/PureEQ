    <string name="notif_all_audio">%1$s · All audio</string>
    <plurals name="notif_music_apps">
        <item quantity="one">%1$s · Music apps · %2$d playing</item>
        <item quantity="other">%1$s · Music apps · %2$d playing</item>
    </plurals>
    <string name="notif_paused">%1$s · paused while PureEQ plays</string>
