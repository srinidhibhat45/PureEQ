    <plurals name="list_more">
        <item quantity="one">%1$s and %2$d more</item>
        <item quantity="other">%1$s and %2$d more</item>
    </plurals>

    <!-- How the system-wide EQ attaches (Settings). -->
    <string name="mode_global">All audio</string>
    <string name="mode_global_detail">Attaches to Android\'s output mix, so every app is covered. Works on most phones.</string>
    <string name="mode_per_app">Music apps</string>
    <string name="mode_per_app_detail">Attaches to players that announce themselves (Spotify, YouTube Music, Samsung Music, Poweramp…). Use this if \"All audio\" has no effect on your phone.</string>

